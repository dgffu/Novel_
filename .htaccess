# NOVEL - Cache Control Configuration for Web Servers (Apache / LiteSpeed)
<IfModule mod_headers.c>
  # Force no-cache on HTML documents so browsers always fetch the updated site structure
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Revalidate CSS and JS assets
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
